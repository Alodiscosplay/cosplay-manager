# ID client OAuth « Application Web » (Google Cloud Console). Ce n'est pas un secret.
VITE_GOOGLE_CLIENT_ID=
# Pour choisir le dossier Drive des photos (Google Picker) : une clé d'API restreinte au domaine du site,
# et le NUMÉRO du projet Google Cloud (pas son nom). Ni l'une ni l'autre n'est un secret.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
